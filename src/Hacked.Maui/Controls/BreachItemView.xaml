<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
             x:Class="Hacked.Maui.Controls.BreachItemView">

    <telerik:RadBorder Background="{StaticResource Blue300Accent}"
                       Padding="5"
                       CornerRadius="5">
        <Grid ColumnDefinitions="Auto, *"
              RowDefinitions="Auto, *">
            <telerik:RadBorder WidthRequest="75"
                               HeightRequest="75"
                               CornerRadius="5"
                               Padding="10"
                               Margin="10"
                               BackgroundColor="{StaticResource DarkTranslucent}">
                <Image Source="{Binding LogoPath}" />
            </telerik:RadBorder>

            <VerticalStackLayout Margin="10,5,10,5"
                                 Grid.Column="1">
                <Label Text="{Binding Name}"
                       FontAttributes="Bold" />
                <Label Text="{Binding BreachDate, StringFormat='Breached on: {0}'}" />
                <Label Text="{Binding PwnCount, StringFormat='Accounts breached: {0}'}" />
                <Label Text="Fabricated!"
                       IsVisible="{Binding IsFabricated}"  />
                <Label Text="Sensitive!"
                       FontAttributes="Bold"
                       IsVisible="{Binding IsSensitive}" />
                <Label Text="Verified!"
                       IsVisible="{Binding IsVerified}" />
                <Label Text="Retired!" 
                       IsVisible="{Binding IsRetired}"/>
                <Label Text="Spam List!"
                       IsVisible="{Binding IsSpamList}" />
            </VerticalStackLayout>

            <!--<telerik:RadItemsControl ItemsSource="{Binding DataClasses}"
                                 ItemTemplate="{StaticResource BreachClassItemTemplate}"
                                 InputTransparent="True"
                                 Margin="0,5,5,5"
                                 Grid.Row="1"
                                 Grid.Column="0" />-->
            <telerik:RadWrapLayout x:Name="WrapLayout"
                                   Orientation="Horizontal"
                                   InputTransparent="True"
                                   Margin="0,5,5,5"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2" />
        </Grid>
    </telerik:RadBorder>
</ContentView>
