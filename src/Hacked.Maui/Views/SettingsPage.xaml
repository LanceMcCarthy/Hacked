<?xml version="1.0" encoding="utf-8" ?>
<views:PageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
          xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
          x:Class="Hacked.Maui.Views.SettingsPage"
          xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
          xmlns:vms="clr-namespace:Hacked.Maui.ViewModels"
          xmlns:views="clr-namespace:Hacked.Maui.Views"
          x:DataType="vms:SettingsViewModel"
          Title="Settings">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <VerticalStackLayout Padding="10">
            <Label Text="Backups"
                   FontSize="18" 
                   FontFamily="Raleway"/>
            
            <HorizontalStackLayout Spacing="10"
                                   Margin="0,20,0,0">
                <telerik:RadButton Text="Import Backup" 
                                   Command="{Binding ImportCommand}"
                                   FontFamily="Raleway"/>
                <telerik:RadCheckBox IsChecked="{Binding RefreshDuringImport, Mode=TwoWay}"
                                     CheckedColor="{StaticResource PrimaryHighContrast}"
                                     CheckedSymbolColor="{StaticResource Secondary}"/>
                <Label Text="Update breaches"
                       VerticalOptions="Center"
                       FontFamily="Raleway"/>
            </HorizontalStackLayout>

            <telerik:RadButton Text="Export Backup" 
                               Command="{Binding ExportCommand}"
                               FontFamily="Raleway"
                               HorizontalOptions="Start"
                               Margin="0,20,0,0"/>
        </VerticalStackLayout>

        <telerik:RadBusyIndicator IsVisible="{Binding IsBusy}"
                                  IsBusy="{Binding IsBusy}"
                                  AnimationType="Animation3"
                                  BackgroundColor="{AppThemeBinding Light={StaticResource LightTranslucent}, Dark={StaticResource DarkTranslucent}}"
                                  AnimationContentColor="{StaticResource Primary}" 
                                  Grid.RowSpan="2"
                                  Grid.Row="0"/>
    </Grid>
</views:PageBase>
