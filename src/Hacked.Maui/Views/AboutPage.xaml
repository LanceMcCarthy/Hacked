<?xml version="1.0" encoding="utf-8" ?>
<views:PageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                x:Class="Hacked.Maui.Views.AboutPage"
                xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
                xmlns:vms="clr-namespace:Hacked.Maui.ViewModels"
                xmlns:views="clr-namespace:Hacked.Maui.Views"
                x:DataType="vms:AboutViewModel"
                Title="About">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderGrid">
        </Grid>

        <Grid x:Name="GearsLogo"
              Grid.Row="1"
              Margin="10">
            <VerticalStackLayout HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <HorizontalStackLayout HorizontalOptions="Center">
                    <Image x:Name="Gear1">
                        <Image.Source>
                            <FontImageSource FontFamily="Font Awesome 6 Free Regular" 
                                             Glyph="&#xf013;" 
                                             Color="#998C62"
                                             FontAutoScalingEnabled="True" 
                                             Size="72"/>
                        </Image.Source>
                    </Image>
                    <Image x:Name="Gear2"
                           Rotation="22.5"
                           Margin="-5,40,-5,0">
                        <Image.Source>
                            <FontImageSource FontFamily="Font Awesome 6 Free Regular" 
                                             Glyph="&#xf013;" 
                                             Color="#D9BA55" 
                                             FontAutoScalingEnabled="True" 
                                             Size="72"/>
                        </Image.Source>
                    </Image>
                    <Image x:Name="Gear3">
                        <Image.Source>
                            <FontImageSource FontFamily="Font Awesome 6 Free Regular" 
                                             Glyph="&#xf013;" 
                                             Color="#5F6484"
                                             FontAutoScalingEnabled="True" 
                                             Size="72"/>
                        </Image.Source>
                    </Image>
                </HorizontalStackLayout>
                <Label FontSize="24"
                       HorizontalOptions="Center"
                       Text="Lancelot Software" 
                       FontFamily="OpenSansSemibold"/>
            </VerticalStackLayout>
        </Grid>

        <VerticalStackLayout Grid.Row="2"
                             Margin="10,0,10,10"
                             VerticalOptions="Start">
            <Label FontAttributes="Bold"
                   Text="Hacked?" />

            <HorizontalStackLayout Spacing="5">
                <Label Text="v"
                       FontSize="Small"
                       Margin="0,0,-4,0"/>
                <Label Text="{Binding AppVersion}"
                       FontSize="Small" />
                <Label Text="© 2016-2024 Lancelot Software"
                       FontSize="Small" />
            </HorizontalStackLayout>

            <Label FontAttributes="Bold"
                   Text="Credits" />
            <Label Text="Json.NET © 2016 Newtonsoft"
                   FontSize="Small" />
            <Label Text="Data from Haveibeenpwned by Troy Hunt"
                   FontSize="Small" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="3"
                             Margin="10,0,10,10"
                             VerticalOptions="End"
                             Spacing="10">
            <telerik:RadButton x:Name="ContactUsButton"
                             Clicked="ContactUsButton_OnClick"
                             Text="contact us"
                             CornerRadius="5"/>
            <telerik:RadButton x:Name="ReviewButton"
                             Clicked="ReviewButton_OnClickButton_OnClick"
                             Text="rate this app"
                             CornerRadius="5" />
        </VerticalStackLayout>
    </Grid>
</views:PageBase>
