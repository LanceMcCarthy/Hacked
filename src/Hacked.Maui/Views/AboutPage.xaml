<?xml version="1.0" encoding="utf-8" ?>
<cm:PageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:cm="clr-namespace:Hacked.Maui.Common"
                x:Class="Hacked.Maui.Views.AboutPage"
                xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
                xmlns:vms="clr-namespace:Hacked.Maui.ViewModels"
                xmlns:res="using:Hacked.Maui.Resources"
                x:DataType="vms:AboutViewModel"
                Title="About">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderGrid">
        </Grid>

        <Grid x:Name="GearsLogo"
              Grid.Row="1"
              Margin="10">
            <VerticalStackLayout HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <HorizontalStackLayout HorizontalOptions="Center">
                    <Image x:Name="Gear1">
                        <Image.Source>
                            <FontImageSource FontFamily="Font Awesome 6 Free Regular" 
                                             Glyph="{x:Static res:IconFont.Gear}" 
                                             Color="{DynamicResource RadSeriesDColor}"
                                             FontAutoScalingEnabled="True" 
                                             Size="72"/>
                        </Image.Source>
                    </Image>
                    <Image x:Name="Gear2"
                           Rotation="22.5"
                           Margin="-5,40,-5,0">
                        <Image.Source>
                            <FontImageSource FontFamily="Font Awesome 6 Free Regular" 
                                             Glyph="{x:Static res:IconFont.Gear}" 
                                             Color="{DynamicResource RadSeriesDBoldColor}" 
                                             FontAutoScalingEnabled="True" 
                                             Size="72"/>
                        </Image.Source>
                    </Image>
                    <Image x:Name="Gear3">
                        <Image.Source>
                            <FontImageSource FontFamily="Font Awesome 6 Free Regular" 
                                             Glyph="{x:Static res:IconFont.Gear}" 
                                             Color="{DynamicResource RadSeriesDBolderColor}"
                                             FontAutoScalingEnabled="True" 
                                             Size="72"/>
                        </Image.Source>
                    </Image>
                </HorizontalStackLayout>
                <Label FontSize="24"
                       HorizontalOptions="Center"
                       Text="Lancelot Software" 
                       FontFamily="Raleway"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource RadOnAppSurfaceColorAlpha80}"/>
            </VerticalStackLayout>
        </Grid>

        <VerticalStackLayout Grid.Row="2"
                             Margin="10,0,10,10"
                             VerticalOptions="Start">
            <Label FontAttributes="Bold"
                   Text="Hacked?" />

            <HorizontalStackLayout Spacing="5">
                <Label Text="v"
                       Margin="0,0,-4,0"
                       TextColor="{DynamicResource RadOnAppSurfaceColorAlpha50}"/>
                <Label Text="{Binding AppVersion}"
                       TextColor="{DynamicResource RadOnAppSurfaceColorAlpha50}"/>
                <Label Text="© 2016-2024 Lancelot Software"
                       TextColor="{DynamicResource RadOnAppSurfaceColorAlpha50}"/>
            </HorizontalStackLayout>

            <Label FontAttributes="Bold"
                   Text="Credits" />
            <Label Text="Json.NET © 2016 Newtonsoft" 
                   TextColor="{DynamicResource RadOnAppSurfaceColorAlpha30}"/>
            <Label Text="Data from Haveibeenpwned by Troy Hunt"
                   TextColor="{DynamicResource RadOnAppSurfaceColorAlpha30}"/>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="3"
                             Margin="10,0,10,10"
                             VerticalOptions="End"
                             Spacing="10">
            <telerik:RadButton x:Name="ContactUsButton"
                             Clicked="ContactUsButton_OnClick"
                             Text="contact us"
                             CornerRadius="5"
                             FontFamily="Raleway"/>
            <telerik:RadButton x:Name="ReviewButton"
                             Clicked="ReviewButton_OnClick"
                             Text="rate this app"
                             CornerRadius="5" 
                             FontFamily="Raleway"/>
        </VerticalStackLayout>
    </Grid>
</cm:PageBase>
