        <VerticalStackLayout Grid.Row="1">
            <Label x:Name="SwipeTip"
                   Text="Swipe items left for delete or right for refresh"
                   TextColor="{DynamicResource ThemeTextColor}"
                   HorizontalTextAlignment="Center"
                   Margin="5"
                   IsVisible="False"
                   LineBreakMode="WordWrap" />

            <Label x:Name="AccountRefreshTip"
                   Text="Pull list down to refresh all accounts"
                   TextColor="{DynamicResource ThemeTextColor}"
                   HorizontalTextAlignment="Center"
                   IsVisible="False"
                   Margin="5"
                   LineBreakMode="WordWrap" />

            <!--<StackLayout Orientation="Horizontal"
                             Margin="5">
                    <Label Text="Show Tips:"
                           TextColor="{DynamicResource ThemeTextColor}" 
                           Margin="0,0,10,0"
                           VerticalOptions="Center"/>

                    <CheckBox x:Name="RefreshTipCheckBox"
                              CheckedChanged="RefreshTipCheckBox_OnCheckedChanged"/>
                </StackLayout>-->
        </VerticalStackLayout>

        <telerik:RadButton x:Name="AddAccountModalButton"
                           Text="add an account"
                           CornerRadius="5"
                           Margin="10"
                           Clicked="AddAccountPopup_Clicked"
                           Grid.Row="2">
            
        </telerik:RadButton>
    </Grid>

    <tp:RadPopup.Popup>
        <tp:RadPopup x:Name="popup"
                     IsModal="True"
                     Placement="Center"
                     OutsideBackgroundColor="#DDFFFFFF">
            <telerik:RadBorder CornerRadius="6"
                               BackgroundColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                               Padding="10">
                <Grid>
                    <VerticalStackLayout Margin="20"
                                         Spacing="10"
                                         Padding="20">
                        <Label Text="Enter an account to monitor"
                               TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />
                        <telerik:RadEntry x:Name="EmailEntry"
                                          Completed="EmailEntry_OnCompleted"
                                          Keyboard="Email"
                                          Placeholder="enter email address or username"
                                          PlaceholderColor="{DynamicResource Yellow100Accent}"
                                          TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                                          BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
                                          TextChanged="EmailEntry_OnTextChanged"
                                          WidthRequest="700" />
                        <telerik:RadButton x:Name="AddAccountButton"
                                           Text="add account"
                                           TextColor="Wheat"
                                           BackgroundColor="DarkRed"
                                           Clicked="AddAccount_OnClicked">
                            <telerik:RadButton.Triggers>
                                <Trigger TargetType="telerik:RadButton"
                                         Property="IsEnabled"
                                         Value="True">
                                    <Setter Property="TextColor"
                                            Value="White" />
                                    <Setter Property="BackgroundColor"
                                            Value="DarkGreen" />
                                </Trigger>
                            </telerik:RadButton.Triggers>
                        </telerik:RadButton>
                        <telerik:RadButton x:Name="CancelButton"
                                           Clicked="CancelButton_OnClicked"
                                           Text="cancel"
                                           TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                                           BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />
                    </VerticalStackLayout>

                    <ActivityIndicator IsVisible="{Binding IsBusy}"
                                       IsRunning="{Binding IsBusy}"
                                       HorizontalOptions="Fill"
                                       VerticalOptions="Fill" />
                </Grid>
            </telerik:RadBorder>
        </tp:RadPopup>
    </tp:RadPopup.Popup>
</ContentPage>
