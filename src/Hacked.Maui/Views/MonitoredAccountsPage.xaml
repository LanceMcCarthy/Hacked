<?xml version="1.0" encoding="utf-8" ?>
<views:PageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                x:Class="Hacked.Maui.Views.MonitoredAccountsPage"
                xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
                xmlns:vms="clr-namespace:Hacked.Maui.ViewModels"
                xmlns:models="clr-namespace:Hacked.Core.Models;assembly=Hacked.Core"
                xmlns:commands="clr-namespace:Hacked.Maui.Commands"
                xmlns:res="clr-namespace:Hacked.Maui.Resources"
                xmlns:views="clr-namespace:Hacked.Maui.Views"
                x:DataType="vms:MonitoredAccountsViewModel"
                Title="Monitored Accounts"
                xmlns:android="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.AndroidSpecific;assembly=Microsoft.Maui.Controls"
                xmlns:commhelpers="clr-namespace:CommonHelpers.Maui.Helpers;assembly=CommonHelpers.Maui"
                android:Application.WindowSoftInputModeAdjust="Resize"
                x:Name="ThisPage">
    <views:PageBase.Resources>
        <Style x:Key="MonitoredAccountsGridHeaderStyle"
               TargetType="telerik:DataGridColumnHeaderAppearance">
            <Setter Property="BackgroundColor"
                    Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}" />
            <Setter Property="HoverBackgroundColor"
                    Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
            <Setter Property="TextColor"
                    Value="{AppThemeBinding Light={StaticResource PrimaryHighContrast}, Dark={StaticResource Gray100}}" />
            <Setter Property="BorderColor"
                    Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
            <Setter Property="SortIndicatorColor"
                    Value="{AppThemeBinding Light={StaticResource PrimaryHighContrast}, Dark={StaticResource Gray200}}" />
            <Setter Property="IndicatorColor"
                    Value="{AppThemeBinding Light={StaticResource PrimaryHighContrast}, Dark={StaticResource Gray200}}" />
            <Setter Property="FilterIndicatorTextColor"
                    Value="{AppThemeBinding Light={StaticResource PrimaryHighContrast}, Dark={StaticResource Gray200}}" />
            <Setter Property="FilterIndicatorActiveTextColor"
                    Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Yellow100Accent}}" />
        </Style>

        <Style x:Key="MonitoredAccountsGridFooterStyle"
               TargetType="telerik:DataGridColumnFooterAppearance">
            <Setter Property="BackgroundColor"
                    Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}" />
            <Setter Property="TextColor"
                    Value="{AppThemeBinding Light={StaticResource PrimaryHighContrast}, Dark={StaticResource Gray100}}" />
            <Setter Property="BorderColor"
                    Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
        </Style>

        <Style x:Key="MonitoredAccountsGroupHeaderStyle"
               TargetType="telerik:DataGridGroupHeaderAppearance">
            <Setter Property="BackgroundColor"
                    Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray900}}" />
            <Setter Property="BorderColor"
                    Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
            <Setter Property="TextColor"
                    Value="{AppThemeBinding Light={StaticResource PrimaryHighContrast}, Dark={StaticResource Gray100}}" />
            <Setter Property="AggregatesTextColor"
                    Value="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
            <Setter Property="ButtonTextColor"
                    Value="{AppThemeBinding Light={StaticResource PrimaryHighContrast}, Dark={StaticResource Gray200}}" />
        </Style>

        <Style x:Key="MonitoredAccountsGridTextCellStyle"
               TargetType="telerik:DataGridTextCellAppearance">
            <Setter Property="TextColor"
                    Value="{AppThemeBinding Light={StaticResource PrimaryHighContrast}, Dark={StaticResource Gray100}}" />
            <Setter Property="SelectedTextColor"
                    Value="{AppThemeBinding Light={StaticResource PrimaryHighContrast}, Dark={StaticResource Gray100}}" />
            <Setter Property="HoverTextColor"
                    Value="{AppThemeBinding Light={StaticResource PrimaryHighContrast}, Dark={StaticResource PrimaryHighContrast}}" />
        </Style>

        <Style x:Key="MonitoredAccountsGridToggleStyle"
               TargetType="telerik:DataGridToggleRowDetailsCellAppearance">
            <Setter Property="ButtonTextColor"
                    Value="{AppThemeBinding Light={StaticResource PrimaryHighContrast}, Dark={StaticResource Gray100}}" />
            <Setter Property="SelectedButtonTextColor"
                    Value="{AppThemeBinding Light={StaticResource PrimaryHighContrast}, Dark={StaticResource Gray100}}" />
            <Setter Property="HoverButtonTextColor"
                    Value="{AppThemeBinding Light={StaticResource PrimaryHighContrast}, Dark={StaticResource PrimaryHighContrast}}" />
        </Style>

        <Style x:Key="MonitoredAccountsGridRowStyle"
               TargetType="telerik:DataGridRowBackgroundAppearance">
            <Setter Property="BackgroundColor"
                    Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}" />
            <Setter Property="BorderColor"
                    Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
        </Style>

        <Style x:Key="MonitoredAccountsGridAlternateRowStyle"
               TargetType="telerik:DataGridRowBackgroundAppearance">
            <Setter Property="BackgroundColor"
                    Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}" />
            <Setter Property="BorderColor"
                    Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
        </Style>
    </views:PageBase.Resources>

    <views:PageBase.ToolbarItems>
        <ToolbarItem x:Name="ShowAddAccountOverlay"
                     Text="Add Account"
                     Command="{Binding ToggleOverlayCommand}"
                     Order="Primary"
                     Priority="0">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="Font Awesome 6 Free Regular"
                                 Glyph="{x:Static res:IconFont.Plus}"
                                 Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Gray100}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </views:PageBase.ToolbarItems>

    <Grid>
        <telerik:RadDataGrid x:Name="MonitoredAccountDataGrid"
                             ItemsSource="{Binding Accounts}"
                             SelectionMode="None"
                             SelectedItem="{Binding SelectedAccount}"
                             AutoGenerateColumns="False"
                             ShowColumnFooters="True"
                             RowBackgroundStyle="{StaticResource MonitoredAccountsGridRowStyle}"
                             AlternateRowBackgroundStyle="{StaticResource MonitoredAccountsGridAlternateRowStyle}"
                             GridLinesColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                             BorderBrush="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                             Loaded="MonitoredAccountDataGrid_OnLoaded">
            <telerik:RadDataGrid.Commands>
                <commands:CustomDataGridCommand Id="CellTap"
                                                Command="{Binding CellTapCommand}" />
            </telerik:RadDataGrid.Commands>
            <telerik:RadDataGrid.Columns>
                <telerik:DataGridToggleRowDetailsColumn CellContentStyle="{StaticResource MonitoredAccountsGridToggleStyle}"
                                                        HeaderStyle="{StaticResource MonitoredAccountsGridHeaderStyle}"
                                                        FooterStyle="{StaticResource MonitoredAccountsGridFooterStyle}" />
                <telerik:DataGridTemplateColumn HeaderText="Options"
                                                HeaderStyle="{StaticResource MonitoredAccountsGridHeaderStyle}"
                                                FooterStyle="{StaticResource MonitoredAccountsGridFooterStyle}"
                                                SizeMode="Auto">
                    <telerik:DataGridTemplateColumn.CellContentTemplate>
                        <DataTemplate x:DataType="models:MonitoredAccount">
                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="5"
                                  Padding="5">
                                <telerik:RadButton Text="{x:Static res:IconFont.Refresh}"
                                                   Style="{StaticResource FontAwesomeLabelStyle}"
                                                   Clicked="RefreshButton_OnClicked"
                                                   CommandParameter="{Binding .}"
                                                   HorizontalOptions="Fill"
                                                   Grid.Column="0"
                                                   Padding="0" />
                                <telerik:RadButton Text="{x:Static res:IconFont.Trash}"
                                                   Style="{StaticResource FontAwesomeLabelStyle}"
                                                   Clicked="RemoveButton_OnClicked"
                                                   CommandParameter="{Binding .}"
                                                   HorizontalOptions="Fill"
                                                   Grid.Column="1"
                                                   Padding="0" />

                                <telerik:RadBusyIndicator IsBusy="{Binding IsUpdating}"
                                                          IsVisible="{Binding IsUpdating}"
                                                          BackgroundColor="{AppThemeBinding Light={StaticResource LightTranslucent}, Dark={StaticResource DarkTranslucent}}"
                                                          AnimationContentColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Gray200}}"
                                                          InputTransparent="{Binding IsUpdating, Converter={StaticResource InvertBoolConverter}}"
                                                          HorizontalOptions="Fill"
                                                          VerticalOptions="Fill"
                                                          AnimationType="Animation5"
                                                          Grid.ColumnSpan="2" />
                            </Grid>
                        </DataTemplate>
                    </telerik:DataGridTemplateColumn.CellContentTemplate>
                </telerik:DataGridTemplateColumn>
                <telerik:DataGridTextColumn x:Name="AddressColumn"
                                            PropertyName="Address"
                                            HeaderStyle="{StaticResource MonitoredAccountsGridHeaderStyle}"
                                            FooterStyle="{StaticResource MonitoredAccountsGridFooterStyle}"
                                            CellContentStyle="{StaticResource MonitoredAccountsGridTextCellStyle}"
                                            HeaderText="Account">
                    <telerik:DataGridTextColumn.AggregateDescriptors>
                        <telerik:PropertyAggregateDescriptor PropertyName="Address"
                                                             Function="Count"
                                                             Caption="Total: " />
                    </telerik:DataGridTextColumn.AggregateDescriptors>
                </telerik:DataGridTextColumn>
                <telerik:DataGridTextColumn x:Name="BreachCountColumn"
                                            PropertyName="Breaches.Count"
                                            HeaderStyle="{StaticResource MonitoredAccountsGridHeaderStyle}"
                                            FooterStyle="{StaticResource MonitoredAccountsGridFooterStyle}"
                                            CellContentStyle="{StaticResource MonitoredAccountsGridTextCellStyle}"
                                            HeaderText="Breaches">
                    <!-- Workaround in DataGrid.Loaded event
                    <telerik:DataGridTextColumn.AggregateDescriptors>
                        <telerik:PropertyAggregateDescriptor PropertyName="Breaches.Count"
                                                             Function="Average"
                                                             Caption="Average per account: " />
                    </telerik:DataGridTextColumn.AggregateDescriptors>-->
                </telerik:DataGridTextColumn>
                <telerik:DataGridDateColumn PropertyName="LastUpdated"
                                            HeaderStyle="{StaticResource MonitoredAccountsGridHeaderStyle}"
                                            FooterStyle="{StaticResource MonitoredAccountsGridFooterStyle}"
                                            CellContentStyle="{StaticResource MonitoredAccountsGridTextCellStyle}"
                                            HeaderText="LastUpdated"
                                            CellContentFormat="{}{0:g}" />
                <telerik:DataGridBooleanColumn PropertyName="HasNewBreaches"
                                               HeaderStyle="{StaticResource MonitoredAccountsGridHeaderStyle}"
                                               FooterStyle="{StaticResource MonitoredAccountsGridFooterStyle}"
                                               CellContentStyle="{StaticResource MonitoredAccountsGridTextCellStyle}"
                                               HeaderText="New Breaches?" />
                <telerik:DataGridNumericalColumn PropertyName="NewBreachCount"
                                                 HeaderStyle="{StaticResource MonitoredAccountsGridHeaderStyle}"
                                                 FooterStyle="{StaticResource MonitoredAccountsGridFooterStyle}"
                                                 CellContentStyle="{StaticResource MonitoredAccountsGridTextCellStyle}"
                                                 HeaderText="New Breach Count">
                    <telerik:DataGridNumericalColumn.AggregateDescriptors>
                        <telerik:PropertyAggregateDescriptor PropertyName="NewBreachCount"
                                                             Function="Count"
                                                             Caption="Total: " />
                    </telerik:DataGridNumericalColumn.AggregateDescriptors>
                </telerik:DataGridNumericalColumn>
            </telerik:RadDataGrid.Columns>
            <telerik:RadDataGrid.RowDetailsTemplate>
                <DataTemplate x:DataType="models:MonitoredAccount">
                    <Grid BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray900}}"
                          ColumnDefinitions="Auto,*">
                        <VerticalStackLayout Spacing="5"
                                             Padding="10"
                                             HorizontalOptions="Start">
                            <Label Text="{Binding LastUpdated, StringFormat='Last Update: {0:g}'}"
                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryHighContrast}, Dark={StaticResource Gray100}}" />

                            <HorizontalStackLayout Spacing="5">
                                <Label Text="{Binding Breaches.Count, StringFormat='Breaches: {0}'}"
                                       TextColor="{AppThemeBinding Light={StaticResource PrimaryHighContrast}, Dark={StaticResource Gray100}}" />
                                <Label Text="{Binding NewBreachCount, StringFormat='({0} new)'}"
                                       TextColor="{AppThemeBinding Light={StaticResource PrimaryHighContrast}, Dark={StaticResource Gray100}}"
                                       IsVisible="{Binding HasNewBreaches}" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="5"
                                                   HorizontalOptions="Start"
                                                   VerticalOptions="End"
                                                   Margin="0,10,0,0">
                                <telerik:RadButton BackgroundColor="{StaticResource Tertiary}"
                                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryHighContrast}, Dark={StaticResource Gray100}}"
                                                   Text="more details..."
                                                   Clicked="MoreDetailsButton_OnClicked"
                                                   CommandParameter="{Binding .}"
                                                   CornerRadius="5" />
                                <telerik:RadButton BackgroundColor="{StaticResource Complimentary1}"
                                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryHighContrast}, Dark={StaticResource Gray900}}"
                                                   Text="clear new"
                                                   Clicked="ClearNewButton_OnClicked"
                                                   CommandParameter="{Binding .}"
                                                   CornerRadius="5" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <telerik:RadCollectionView x:Name="BreachesListView"
                                                   ItemsSource="{Binding Breaches}"
                                                   SelectionMode="None"
                                                   Margin="10,0,0,0"
                                                   Grid.Column="1"
                                                   HeightRequest="220"
                                                   VerticalOptions="Start">
                            <telerik:RadCollectionView.ItemViewStyle>
                                <Style TargetType="telerik:RadCollectionViewItemView">
                                    <Setter Property="BackgroundColor"
                                            Value="Transparent" />
                                    <Setter Property="BorderThickness"
                                            Value="5,5,0,0" />
                                </Style>
                            </telerik:RadCollectionView.ItemViewStyle>
                            <telerik:RadCollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Breach">
                                    <telerik:RadBorder Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                                                       CornerRadius="2">
                                        <Grid ColumnDefinitions="Auto, *"
                                              RowDefinitions="Auto, *">
                                            <telerik:RadBorder WidthRequest="75"
                                                               HeightRequest="75"
                                                               CornerRadius="5"
                                                               Padding="5"
                                                               Margin="5"
                                                               BackgroundColor="{StaticResource DarkTranslucent}">
                                                <Image Source="{Binding LogoPath}" />
                                            </telerik:RadBorder>
                                            <VerticalStackLayout Margin="10,5,10,5"
                                                                 Grid.Column="1">
                                                <Label Text="{Binding Name}"
                                                       FontAttributes="Bold" />
                                                <Label Text="{Binding BreachDate, StringFormat='Breached: {0:d}'}" />
                                                <Label Text="{Binding PwnCount, StringFormat='Accounts: {0}'}" />
                                                <Label Text="{Binding DataClasses.Count, StringFormat='Data types: {0}'}" />
                                            </VerticalStackLayout>

                                            <Label Text="{x:Static res:IconFont.ExclamationTriangle}"
                                                   TextColor="{AppThemeBinding Light={StaticResource Complimentary1}, Dark={StaticResource Yellow100Accent}}"
                                                   Style="{StaticResource FontAwesomeLabelStyle}"
                                                   IsVisible="{Binding IsNew}"
                                                   HorizontalOptions="End"
                                                   VerticalOptions="Start"
                                                   Margin="5"
                                                   FontSize="18"
                                                   Grid.Column="1" />
                                        </Grid>
                                    </telerik:RadBorder>
                                </DataTemplate>
                            </telerik:RadCollectionView.ItemTemplate>
                            <telerik:RadCollectionView.ItemsLayout>
                                <telerik:CollectionViewGridLayout Orientation="Horizontal"
                                                                  SpanCount="2"
                                                                  HorizontalItemSpacing="5"
                                                                  VerticalItemSpacing="5" />
                            </telerik:RadCollectionView.ItemsLayout>
                        </telerik:RadCollectionView>
                    </Grid>
                </DataTemplate>
            </telerik:RadDataGrid.RowDetailsTemplate>
        </telerik:RadDataGrid>

        <!-- Add New Account Overlay -->
        <Grid BackgroundColor="{AppThemeBinding Light={StaticResource LightTranslucent}, Dark={StaticResource DarkTranslucent}}"
              IsVisible="{Binding IsOverlayVisible}">
            <telerik:RadBorder x:Name="OverlayBorder"
                               CornerRadius="5"
                               BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray900}}"
                               BorderColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}"
                               Padding="10"
                               Margin="{OnPlatform WinUI='120,40', MacCatalyst='120,40', iOS='40,40', Android='40,40'}"
                               BorderThickness="2">
                <Grid RowDefinitions="Auto, *, Auto, Auto"
                      RowSpacing="10"
                      Margin="20">

                    <Label Text="Add account(s) to monitor:"
                           HorizontalOptions="Start"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Gray100}}"
                           Grid.Row="0" />

                    <telerik:RadCollectionView x:Name="PendingAccountsView"
                                               ItemsSource="{Binding PendingAdditions}"
                                               BackgroundColor="Transparent"
                                               Grid.Row="1">
                        <telerik:RadCollectionView.ItemViewStyle>
                            <Style TargetType="telerik:RadCollectionViewItemView">
                                <Setter Property="BorderThickness"
                                        Value="0" />
                            </Style>
                        </telerik:RadCollectionView.ItemViewStyle>
                        <telerik:RadCollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:PendingAccount">
                                <Grid ColumnDefinitions="*, Auto"
                                      RowDefinitions="*,Auto"
                                      ColumnSpacing="5"
                                      RowSpacing="5">
                                    <telerik:RadEntry Keyboard="Email"
                                                      Placeholder="enter email/username/phone..."
                                                      Text="{Binding Address, Mode=TwoWay}"
                                                      HorizontalOptions="Fill"
                                                      BackgroundColor="{AppThemeBinding Light={StaticResource WhiteBrush}, Dark={StaticResource BlackBrush}}"
                                                      TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                                                      PlaceholderColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                                                      commhelpers:FocusElementHelper.IsFocused="{Binding IsFocused, Mode=TwoWay}" />
                                    <telerik:RadButton Text="➖"
                                                       Clicked="RemovePendingItemButton_OnClicked"
                                                       CommandParameter="{Binding}"
                                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Gray100}}"
                                                       BorderColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Gray200}}"
                                                       BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray600}}"
                                                       BorderThickness="1"
                                                       Grid.Column="1"
                                                       Padding="5,0,5,0"
                                                       Margin="5,0,0,0" />
                                    <telerik:RadButton Text="➕"
                                                       Clicked="AddPendingItemButton_OnClicked"
                                                       IsVisible="{Binding IsLast}"
                                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Gray100}}"
                                                       BorderColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Gray200}}"
                                                       BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray600}}"
                                                       BorderThickness="1"
                                                       Padding="5"
                                                       Margin="0,0,0,0"
                                                       Grid.Row="1"/>
                                </Grid>
                            </DataTemplate>
                        </telerik:RadCollectionView.ItemTemplate>
                    </telerik:RadCollectionView>

                    <telerik:RadButton x:Name="AddAccountButton"
                                       Text="add account(s)"
                                       Command="{Binding AddAccountsCommand}"
                                       IsEnabled="{Binding IsAddEnabled}"
                                       CornerRadius="5"
                                       Grid.Row="2" />

                    <telerik:RadButton x:Name="CancelButton"
                                       Text="cancel"
                                       Command="{Binding CancelAddAccountsCommand}"
                                       CornerRadius="5"
                                       Grid.Row="3" />

                    <telerik:RadBusyIndicator IsVisible="{Binding IsBusy}"
                                              IsBusy="{Binding IsBusy}"
                                              InputTransparent="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                                              AnimationType="Animation5"
                                              Grid.Row="0"
                                              Grid.RowSpan="4" />
                </Grid>
            </telerik:RadBorder>
        </Grid>
    </Grid>
</views:PageBase>