                                           TextColor="White"
                                           BackgroundColor="#00BF32"
                                           Clicked="RefreshSwipeButton_Clicked"
                                           Command="{Binding RefreshAccountCommand, Source={x:RelativeSource AncestorType={x:Type vms:MonitoredAccountsViewModel}}}"
                                           CommandParameter="{Binding}" />

                        <telerik:RadButton Text="{x:Static res:IconFont.Trash}"
                                           Style="{StaticResource FontAwesomeLabelStyle}"
                                           TextColor="White"
                                           BackgroundColor="#CE0005"
                                           Grid.Column="2"
                                           Clicked="DeleteSwipeButton_Clicked"
                                           Command="{Binding RemoveAccountCommand, Source={x:RelativeSource AncestorType={x:Type vms:MonitoredAccountsViewModel}}}"
                                           CommandParameter="{Binding}" />
