<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hacked.Maui.Views.MonitoredAccountsPage"
             xmlns:telerik="clr-namespace:Telerik.Maui.Controls;assembly=Telerik.Maui.Controls"
             xmlns:tdc="clr-namespace:Telerik.XamarinForms.DataControls;assembly=Telerik.Maui.Controls.Compatibility"
             xmlns:tlv="clr-namespace:Telerik.XamarinForms.DataControls.ListView;assembly=Telerik.Maui.Controls.Compatibility"
             xmlns:tp="clr-namespace:Telerik.XamarinForms.Primitives;assembly=Telerik.Maui.Controls.Compatibility"
             xmlns:tlvc="clr-namespace:Telerik.XamarinForms.DataControls.ListView.Commands;assembly=Telerik.Maui.Controls.Compatibility"
             xmlns:tdg="clr-namespace:Telerik.XamarinForms.DataGrid;assembly=Telerik.Maui.Controls.Compatibility"
             xmlns:vms="clr-namespace:Hacked.Maui.ViewModels"
             xmlns:models="clr-namespace:Hacked.Core.Models;assembly=Hacked.Core"
             xmlns:commands="clr-namespace:Hacked.Maui.Common.Commands"
             xmlns:behaviors="clr-namespace:Hacked.Maui.Behaviors"
             xmlns:res="clr-namespace:Hacked.Maui.Resources"
             xmlns:controls="clr-namespace:Hacked.Maui.Controls"
             BindingContext="{x:Static vms:ViewModelLocator.MonitoredAccounts}"
             Title="Monitored Accounts">

    <Grid x:Name="RootGrid"
          RowDefinitions="*, Auto, Auto">
        <tdg:RadDataGrid x:Name="MonitoredAccountDataGrid"
                         ItemsSource="{Binding Accounts}"
                         SelectionMode="None"
                         SelectedItem="{Binding SelectedAccount}"
                         AutoGenerateColumns="False">
            <tdg:RadDataGrid.Commands>
                <commands:CustomDataGridCommand Id="CellTap"
                                                Command="{Binding CellTapCommand}" />
            </tdg:RadDataGrid.Commands>
            <tdg:RadDataGrid.Columns>
                <tdg:DataGridTemplateColumn HeaderText="Options"
                                            SizeMode="Fixed"
                                            Width="110">
                    <tdg:DataGridTemplateColumn.CellContentTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="5">
                                
                                <HorizontalStackLayout Padding="5"
                                                       Spacing="5">
                                    <!--<telerik:RadButton Text="{x:Static res:IconFont.InfoCircle}"
                                                       Style="{StaticResource FontAwesomeLabelStyle}"
                                                       Command="{Binding BindingContext.ViewDetailsCommand, Source={x:Reference MonitoredAccountDataGrid}}"
                                                       CommandParameter="{Binding}"
                                                       Margin="5" />-->
                                    <telerik:RadButton Text="{x:Static res:IconFont.Refresh}"
                                                       Style="{StaticResource FontAwesomeLabelStyle}"
                                                       Command="{Binding BindingContext.RefreshAccountCommand, Source={x:Reference MonitoredAccountDataGrid}}"
                                                       CommandParameter="{Binding}"
                                                       HorizontalOptions="Fill"/>
                                    <telerik:RadButton Text="{x:Static res:IconFont.Trash}"
                                                       Style="{StaticResource FontAwesomeLabelStyle}"
                                                       Command="{Binding BindingContext.RemoveAccountCommand, Source={x:Reference MonitoredAccountDataGrid}}"
                                                       CommandParameter="{Binding}"
                                                       HorizontalOptions="Fill"/>
                                </HorizontalStackLayout>

                                <telerik:RadBorder IsVisible="{Binding IsUpdating}"
                                                   InputTransparent="{Binding IsUpdating, Converter={StaticResource InvertBoolConverter}}"
                                                   BackgroundColor="{AppThemeBinding Light={StaticResource LightTranslucent}, Dark={StaticResource DarkTranslucent}}">
                                    <Label Text="Refreshing..."
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </telerik:RadBorder>

                                <!--<tp:RadBusyIndicator IsBusy="{Binding IsUpdating}"
                                                     InputTransparent="{Binding IsUpdating, Converter={StaticResource InvertBoolConverter}}"
                                                     AnimationType="Animation5"/>-->
                            </Grid>
                        </DataTemplate>
                    </tdg:DataGridTemplateColumn.CellContentTemplate>
                </tdg:DataGridTemplateColumn>
                
                <tdg:DataGridTextColumn PropertyName="Address"
                                        HeaderText="Account" />

                <!--<tdg:DataGridTextColumn PropertyName="Breaches.Count"
                                        HeaderText="Breaches">
                    <tdg:DataGridTextColumn.CellContentTemplate>
                        <DataTemplate>
                            <Label Text="{Binding Breaches.Count}"
                                   Margin="0, 5, 0, 5"
                                   HorizontalOptions="Center"
                                   VerticalTextAlignment="Center" />
                        </DataTemplate>
                    </tdg:DataGridTextColumn.CellContentTemplate>
                </tdg:DataGridTextColumn>-->

                <tdg:DataGridTemplateColumn HeaderText="Breaches">
                    <tdg:DataGridTemplateColumn.CellContentTemplate>
                        <DataTemplate>
                            <Label Text="{Binding Breaches.Count}"
                                   Margin="0, 5, 0, 5"
                                   HorizontalOptions="Center"
                                   VerticalTextAlignment="Center" />
                        </DataTemplate>
                    </tdg:DataGridTemplateColumn.CellContentTemplate>
                </tdg:DataGridTemplateColumn>

                <tdg:DataGridDateColumn PropertyName="LastUpdated"
                                        HeaderText="LastUpdated"
                                        CellContentFormat="{}{0: ddd-d-MMM-yyyy}" />

                <tdg:DataGridBooleanColumn PropertyName="HasNewBreaches"
                                           HeaderText="New Breaches?" />
                
                <tdg:DataGridBooleanColumn PropertyName="NewBreachCount"
                                           HeaderText="New Breach Count" />
            </tdg:RadDataGrid.Columns>
        </tdg:RadDataGrid>

        <!-- Not needed, will style custom item template directly
             ItemStyle="{StaticResource NormalItemStyle}"
             SelectedItemStyle="{StaticResource SelectedItemStyle}"
             PressedItemStyle="{StaticResource PressedItemStyle}"
             ReorderItemStyle="{StaticResource ReorderItemStyle}"
        
        <OnPlatform x:TypeArguments="x:Double">
                                    <On Platform="iOS, Android"
                                        Value="200"/>
                                    <On Platform="WinUI, MacCatalyst"
                                        Value="200"/>
                                </OnPlatform>
        -->

        <!-- TODO add later, when UX is better (use OnPlatform to only allow on mobile)
             IsPullToRefreshEnabled="{Binding HasAccounts}"
             SwipeOffset="70, 0, 70, 0"
             SwipeThreshold="10"
        -->

