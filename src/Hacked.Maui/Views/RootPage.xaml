<FlyoutPage  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Hacked.Maui.Views"
             x:Class="Hacked.Maui.Views.RootPage">
    <FlyoutPage.Flyout>
        <views:MenuPage x:Name="SideMenuPage" Title="Menu" />
    </FlyoutPage.Flyout>
    <FlyoutPage.Detail>
        <NavigationPage Style="{StaticResource NavPageStyle}" Title="Main">
            <x:Arguments>
                <views:AccountsPage Title="Accounts"/>
            </x:Arguments>
        </NavigationPage>
    </FlyoutPage.Detail>
</FlyoutPage>