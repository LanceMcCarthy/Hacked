<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:telerikMaui="clr-namespace:Telerik.Maui;assembly=Telerik.Maui.Core"
                    xmlns:telerikMauiControls="clr-namespace:Telerik.Maui.Controls;assembly=Telerik.Maui.Controls"
                    xmlns:telerikInputView="clr-namespace:Telerik.Maui.Controls.InputView;assembly=Telerik.Maui.Controls"
                    x:Class="Telerik.Theming.Platform.Styles.Editor">

    <!-- This is autogenerated file. Use as reference. Do not modify. -->

    <!-- Dependencies: InputView.xaml -->

    <Style x:Key="DefaultTextInputStyle" TargetType="telerikMauiControls:RadMultilineTextInput" BasedOn="{StaticResource DefaultInputViewStyle}">
        <Setter Property="AutoSize" Value="{TemplateBinding AutoSize}" />
        <Setter Property="MaxLines" Value="{TemplateBinding MaxLines}" />
        <Setter Property="Padding" Value="{TemplateBinding Padding}" />
        <Setter Property="HorizontalTextAlignment" Value="{TemplateBinding HorizontalTextAlignment}" />
        <Setter Property="VerticalTextAlignment" Value="{TemplateBinding VerticalTextAlignment}" />
        <Setter Property="SelectionOnFocus" Value="{TemplateBinding SelectionOnFocus}" />
        <Setter Property="MinimumHeightRequest" Value="{TemplateBinding MinimumHeightRequest}" />
        <Setter Property="MinimumWidthRequest" Value="{TemplateBinding MinimumWidthRequest}" />
        <Setter Property="PlaceholderColor" Value="{TemplateBinding PlaceholderColor}" />
        <Setter Property="TextColor" Value="{TemplateBinding TextColor}" />
    </Style>

    <ControlTemplate x:Key="RadEditor_ControlTemplate">
        <Grid RowDefinitions="*, Auto"
              ColumnDefinitions="*, Auto">
            <Grid ColumnDefinitions="*, Auto"
                  BackgroundColor="{TemplateBinding BackgroundColor}"
                  Background="{TemplateBinding Background}"
                  telerikMauiControls:ViewUtils.CornerRadius="{TemplateBinding CornerRadius}">
                <telerikMauiControls:RadMultilineTextInput Text="{TemplateBinding Text, Mode=TwoWay}"
                                                           Style="{TemplateBinding ActualTextInputStyle}"
                                                           AutomationId="RadEditorTextInput" />
                <telerikMauiControls:RadTemplatedButton Style="{TemplateBinding ActualClearButtonStyle}"
                                                        telerikMauiControls:KeyboardHelper.IsTabStop="False"
                                                        AutomationId="RadEditorClearButton" />
            </Grid>
            <telerikMauiControls:RadBorder BackgroundColor="Transparent"
                                           InputTransparent="True"
                                           BorderColor="{TemplateBinding BorderColor}"
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           BorderThickness="{TemplateBinding BorderThickness}"
                                           CornerRadius="{TemplateBinding CornerRadius, Converter={x:Static telerikMauiControls:CornerRadiusToThicknessConverter.Instance}}" />
            <OnPlatform x:TypeArguments="View">
                <On Platform="Android, iOS">
                    <Label Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Style="{TemplateBinding ActualValidationErrorLabelStyle}"
                           AutomationId="RadEditorErrorIndicator" />
                </On>
                <On Platform="MacCatalyst, WinUI">
                    <Image Grid.Column="1"
                           Style="{TemplateBinding ActualValidationErrorImageStyle}"
                           AutomationId="RadEditorErrorIndicator" />
                </On>
            </OnPlatform>
        </Grid>
    </ControlTemplate>

    <Style x:Key="RadEditorStyle" TargetType="telerikMauiControls:RadEditor" BasedOn="{StaticResource RadInputViewStyle}">
        <Setter Property="ControlTemplate" Value="{StaticResource RadEditor_ControlTemplate}" />
    </Style>
    <Style TargetType="telerikMauiControls:RadEditor" BasedOn="{StaticResource RadEditorStyle}" />
</ResourceDictionary>
