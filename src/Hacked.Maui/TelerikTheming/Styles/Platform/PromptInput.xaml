                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource RadButtonPressedTextColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState Name="FocusedPressed">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource RadButtonPressedTextColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState Name="Listening">
                        <VisualState.Setters>
                            <Setter Property="Content" Value="{x:Static telerikMaui:TelerikFont.IconStopRecording}" />
                            <Setter Property="TextColor" Value="{DynamicResource RadOnPrimaryColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState Name="ListeningMouseOver">
                        <VisualState.Setters>
                            <Setter Property="Content" Value="{x:Static telerikMaui:TelerikFont.IconStopRecording}" />
                            <Setter Property="TextColor" Value="{DynamicResource RadOnPrimaryColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState Name="ListeningPressed">
                        <VisualState.Setters>
                            <Setter Property="Content" Value="{x:Static telerikMaui:TelerikFont.IconStopRecording}" />
                            <Setter Property="TextColor" Value="{DynamicResource RadOnPrimaryColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState Name="Error">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource RadOnErrorColor}" />
                            <Setter Property="BackgroundColor" Value="{DynamicResource RadErrorColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource RadButtonDisabledTextColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="PromptInputMultilineTextInputStyle" TargetType="telerikMauiControls:RadMultilineTextInput">
        <Setter Property="Keyboard" Value="Text" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="telerikMauiControls:KeyboardHelper.IsTranslationSource" Value="True" />
        <Setter Property="MinimumHeightRequest" Value="{OnPlatform Default=20, MacCatalyst=16}" />
        <Setter Property="Padding" Value="{OnPlatform Default='0, 5, 0, 4', MacCatalyst='0, 5', WinUI='0, 4, 0, 5'}" />
    </Style>

    <Style x:Key="PromptInputCompactTextInputStyle" TargetType="telerikMauiControls:RadTextInput">
        <Setter Property="Keyboard" Value="Text" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="telerikMauiControls:KeyboardHelper.IsTranslationSource" Value="True" />
        <Setter Property="MinimumHeightRequest" Value="{OnPlatform Default=20, MacCatalyst=16}" />
        <Setter Property="Padding" Value="{OnPlatform Default='0, 5, 0, 4', MacCatalyst='0, 2', WinUI='0, 4, 0, 5'}" />
    </Style>

    <ControlTemplate x:Key="PromptInputControlTemplate">
        <telerikMauiControls:RadBorder Background="{TemplateBinding Background}"
                                       BackgroundColor="{TemplateBinding BackgroundColor}"
                                       BorderColor="{TemplateBinding BorderColor}"
                                       BorderBrush="{TemplateBinding BorderBrush}"
                                       BorderThickness="{TemplateBinding BorderThickness}"
                                       CornerRadius="{TemplateBinding CornerRadius}"
                                       Padding="0, 4">
            <Grid RowDefinitions="Auto, Auto, Auto">
                <telerikPromptInput:PromptInputAttachedFilesView x:Name="PromptInputAttachedFiles">
                    <telerikPromptInput:PromptInputAttachedFilesView.Triggers>
                        <DataTrigger TargetType="telerikPromptInput:PromptInputAttachedFilesView"
                                     Binding="{Binding AttachedFiles.Count, Source={RelativeSource TemplatedParent}}"
                                     Value="0">
                            <Setter Property="Margin" Value="0" />
                        </DataTrigger>
                    </telerikPromptInput:PromptInputAttachedFilesView.Triggers>
                </telerikPromptInput:PromptInputAttachedFilesView>
                <ContentPresenter x:Name="PART_TopAffixContentPresenter"
                                  Grid.Row="1"
                                  Margin="8,0" />
                <telerikPromptInput:RadAnimatedGrid x:Name="PART_AnimatedGrid"
                                                    Grid.Row="2"
                                                    VerticalOptions="Center"
                                                    Padding="{TemplateBinding ContentPadding}"
                                                    RowDefinitions="Auto, Auto, Auto, Auto"
                                                    ColumnDefinitions="Auto, Auto, *, Auto, Auto, Auto">

                    <telerikMauiControls:RadDropDownButton x:Name="PART_MoreButton"
                                                           Content="{Static telerikMaui:TelerikFont.IconPlus}"
                                                           FontFamily="{Static telerikMaui:TelerikFont.Name}"
                                                           FontSize="{OnPlatform Default=16, MacCatalyst=12}"
                                                           Grid.Row="3"
                                                           HorizontalOptions="Start"
                                                           IsVisible="{TemplateBinding IsMoreButtonVisible}"
                                                           Style="{TemplateBinding ActualMoreButtonStyle}"
                                                           AutomationId="RadPromptInputMoreButton" />
                    <ContentPresenter x:Name="PART_StartAffixContentPresenter"
                                      Grid.Row="3"
                                      Grid.Column="1"
                                      Margin="8,0" />
                    <BoxView Grid.Row="3"
                             Grid.Column="0"
                             Grid.ColumnSpan="6"
                             telerikPromptInput:RadAnimatedGrid.Row="2"
                             BackgroundColor="Transparent"
                             IsVisible="True"
                             HeightRequest="8">
                        <BoxView.Triggers>
                            <DataTrigger TargetType="BoxView"
                                         Binding="{Binding DisplayMode, Source={RelativeSource TemplatedParent}}"
                                         Value="Expanded">
                                <Setter Property="Grid.Row" Value="2" />
                            </DataTrigger>
                            <DataTrigger TargetType="BoxView"
                                         Binding="{Binding DisplayMode, Source={RelativeSource TemplatedParent}}"
                                         Value="Compact">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </BoxView.Triggers>
                    </BoxView>

                    <ContentView x:Name="PART_PromptInputContainer"
                                 Grid.Row="3"
                                 Grid.Column="2"
                                 Grid.ColumnSpan="1"
                                 telerikPromptInput:RadAnimatedGrid.Row="1"
                                 telerikPromptInput:RadAnimatedGrid.Column="0"
                                 telerikPromptInput:RadAnimatedGrid.ColumnSpan="6"
                                 Margin="4, 0">
                       <ContentView.Triggers>
                           <DataTrigger TargetType="ContentView"
                                        Binding="{Binding DisplayMode, Source={RelativeSource TemplatedParent}}"
                                        Value="Expanded">
                               <Setter Property="Grid.Row" Value="1" />
                               <Setter Property="Grid.Column" Value="0" />
                               <Setter Property="Grid.ColumnSpan" Value="6" />
                           </DataTrigger>
                       </ContentView.Triggers>
                   </ContentView>
                   <ContentPresenter x:Name="PART_EndAffixContentPresenter"
                                      Grid.Row="3"
                                      Grid.Column="3"
                                      Margin="8, 0" />
                    <telerikMauiControls:RadSpeechToTextButton x:Name="PART_SpeechToTextButton"
                                                               Grid.Row="3"
                                                               Grid.Column="4"
                                                               telerikMauiControls:StyleHelper.InheritedStyleClass="{TemplateBinding ActualStyleClass}"
                                                               Style="{Binding ActualSpeechToTextButtonStyle, Source={RelativeSource AncestorType={x:Type telerikMauiControls:RadPromptInput}}}"
                                                               AutomationId="RadPromptInputSpeechToTextButton" />

                    <telerikMauiControls:RadTemplatedButton x:Name="SendButton"
                                                            Grid.Row="3"
                                                            Grid.Column="5"
                                                            Command="{TemplateBinding SendMessageCommand}"
                                                            Content="{Binding SendMessageButtonImage.Glyph, Source={RelativeSource Mode=TemplatedParent}, FallbackValue={x:Static telerikMaui:TelerikFont.IconSendMessage}}"
                                                            telerikMauiControls:StyleHelper.InheritedStyleClass="{TemplateBinding ActualStyleClass}"
                                                            Style="{Binding ActualSendButtonStyle, Source={RelativeSource AncestorType={x:Type telerikMauiControls:RadPromptInput}}}"
                                                            AutomationId="RadPromptInputSendMessageButton" />
                </telerikPromptInput:RadAnimatedGrid>
            </Grid>
        </telerikMauiControls:RadBorder>
    </ControlTemplate>

    <Style x:Key="RadPromptInputStyle" TargetType="telerikMauiControls:RadPromptInput">
        <Setter Property="TextColor" Value="{DynamicResource RadPromptInputTextColor}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource RadSubtleColor}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource RadPromptInputBackgroundColor}" />
        <Setter Property="BorderColor" Value="{DynamicResource RadBorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ContentPadding" Value="{OnPlatform Default='8, 4', MacCatalyst='6, 4'}" />
        <Setter Property="MinimumHeightRequest" Value="{OnPlatform Default=36, MacCatalyst=28}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="DisplayMode" Value="{OnIdiom Default=Automatic, Desktop=Expanded}" />
        <Setter Property="IsSpeechToTextButtonVisible" Value="{OnPlatform Default=True, WinUI=False}" />
        <Setter Property="IsMoreButtonVisible" Value="True" />
        <Setter Property="telerikMauiControls:KeyboardHelper.IsTranslationTarget" Value="True" />
        <Setter Property="telerikMauiControls:KeyboardHelper.IsTranslationPivot" Value="True" />
        <Setter Property="SpeechToTextButtonStyle" Value="{StaticResource PromptInputSpeechToTextButtonStyle}" />
        <Setter Property="MoreButtonStyle" Value="{StaticResource PromptInputMoreButtonStyle}" />
        <Setter Property="SendMessageButtonImage" Value="{StaticResource PromptInputSendButtonImageSource}" />
        <Setter Property="SendButtonStyle" Value="{StaticResource PromptInputSendButtonStyle}" />
        <Setter Property="MoreButtonActionItemViewStyle" Value="{StaticResource PromptInputMoreButtonActionItemViewStyle}" />
    </Style>
    <Style TargetType="telerikMauiControls:RadPromptInput" BasedOn="{StaticResource RadPromptInputStyle}" />
</ResourceDictionary>