<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Hacked.Forms.Portable.ViewModels;assembly=Hacked.Forms.Portable"
             BindingContext="{x:Static viewModels:ViewModelLocator.Main}"
             x:Class="Hacked.Forms.Portable.Views.AboutPage"
             Title="{Binding Title}">

    <Grid BackgroundColor="{DynamicResource ThemeBackgroundColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderGrid">
        </Grid>

        <Grid x:Name="GearsLogo"
              Grid.Row="1"
              Margin="10">

            <StackLayout  HorizontalOptions="Center"
                          VerticalOptions="Center">
                <StackLayout Orientation="Horizontal"
                             HorizontalOptions="Center">
                    <Image x:Name="RedGear"
                           HeightRequest="80"
                           WidthRequest="80"
                           Source="GearRed100.png" />
                    <Image x:Name="GreenGear"
                           HeightRequest="80"
                           WidthRequest="80"
                           Rotation="22.5"
                           Source="GearGreen100.png"
                           Margin="-10,0,-10,0" />
                    <Image x:Name="BlueGear"
                           HeightRequest="80"
                           WidthRequest="80"
                           Source="GearBlue100.png" />
                </StackLayout>
                <Label FontSize="24"
                       TextColor="{DynamicResource ThemeTextColor}"
                       HorizontalOptions="Center"
                       Text="Lancelot Software, LLC" />
            </StackLayout>
        </Grid>

        <StackLayout Grid.Row="2"
                     Margin="10,0,10,10"
                     VerticalOptions="Start">
            <Label FontAttributes="Bold"
                   TextColor="{DynamicResource ThemeTextColor}"
                   Text="Hacked?" />

            <StackLayout Orientation="Horizontal"
                         Spacing="5">
                <Label Text="v"
                       TextColor="{DynamicResource ThemeTextLightColor}"
                       FontSize="Small" />
                <Label Text="{Binding AppVersion}"
                       TextColor="{DynamicResource ThemeTextLightColor}"
                       FontSize="Small" />
                <Label Text="© 2016 Lancelot Software"
                       TextColor="{DynamicResource ThemeTextLightColor}"
                       FontSize="Small" />
            </StackLayout>

            <Label FontAttributes="Bold"
                   TextColor="{DynamicResource ThemeTextLightColor}"
                   Text="Credits" />
            <Label Text="Json.NET © 2016 Newtonsoft"
                   TextColor="{DynamicResource ThemeTextLightColor}"
                   FontSize="Small" />
            <Label Text="Data from Haveibeenpwned by Troy Hunt"
                   TextColor="{DynamicResource ThemeTextLightColor}"
                   FontSize="Small" />
        </StackLayout>

        <StackLayout Grid.Row="3"
                     Margin="10,0,10,10"
                     VerticalOptions="End">
            <Button x:Name="ContactUsButton"
                    Clicked="ContactUsButton_OnClick"
                    Text="contact us" />
            <Button x:Name="ReviewButton"
                    Clicked="ReviewButton_OnClickButton_OnClick"
                    Text="rate this app" />
        </StackLayout>
    </Grid>
</ContentPage>