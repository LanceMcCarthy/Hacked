<UserControl x:Name="Self"
             x:Class="Hacked.Controls.KudosControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Hacked.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:tkControls="using:Telerik.UI.Xaml.Controls"
             xmlns:primitives="using:Telerik.UI.Xaml.Controls.Primitives"
             xmlns:controls="using:Microsoft.Toolkit.Uwp.UI.Controls"
             xmlns:extensions="using:Microsoft.Toolkit.Uwp.UI.Extensions"
             xmlns:animations="using:Microsoft.Toolkit.Uwp.UI.Animations"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="800">

    <Grid Background="{ThemeResource SystemControlChromeHighAcrylicElementMediumBrush}">
        <controls:DropShadowPanel BlurRadius="20.0"
                                  ShadowOpacity="0.50"
                                  OffsetX="5.0"
                                  OffsetY="5.0"
                                  Color="Black"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center">
            <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                  Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="HeaderGrid"
                      Background="{ThemeResource SystemControlHighlightAltListAccentLowBrush}">
                    <TextBlock Text="Available Kudos"
                               FontWeight="SemiBold"
                               Style="{StaticResource TitleTextBlockStyle}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <Button Content="Kudos Guide"
                            Foreground="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                            HorizontalAlignment="Left"
                            Margin="10">
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel MaxWidth="400">
                                    <TextBlock Text="Kudos Guide"
                                               Style="{StaticResource TitleTextBlockStyle}" />
                                    <TextBlock TextWrapping="Wrap">
                                <Run Text="Video Ad"
                                        FontWeight="SemiBold" />
                                <LineBreak />
                                <Run Text="You can play a quick video ad to generate revenue for the app (if you see a loading indicator, the next ad is being prepared)." />
                                <LineBreak />
                                <LineBreak />
                                <Run Text="Rating"
                                        FontWeight="SemiBold" />
                                <LineBreak />
                                <Run Text="You can leave an app review to let other potential users how much you like the app." />
                                <LineBreak />
                                <LineBreak />
                                <Run Text="Durable"
                                        FontWeight="SemiBold" />
                                <LineBreak />
                                <Run Text="A 'durable' is a permanent feature purchase, it is unlocked forever." />
                                <LineBreak />
                                <LineBreak />
                                <Run Text="Consumables"
                                        FontWeight="SemiBold" />
                                <LineBreak />
                                <Run Text="To make monetary donations easy, the coffee, lunch and dinner items are in-app-purchases. Since they're 'consumable', you can purchase these items as often as you want to (e.g. a reward after a major update, etc)." />
                                <LineBreak />
                                <LineBreak />
                                <Run Text="Subscription"
                                        FontWeight="SemiBold" />
                                <LineBreak />
                                <Run Text="A low, monthly, automatic donation using your Microsoft Account (no extra payment information required), you can cancel at ANY time. When you become a champion, extra features will start become enabled as we add more. To start, we've created export/import to file capabilities." />
                                    </TextBlock>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button Content="X"
                            Command="{Binding ShowKudosCommand}"
                            Foreground="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                            HorizontalAlignment="Right"
                            Margin="10" />
                </Grid>

                <GridView x:Name="KudosGridView"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="KudosGridView_OnItemClick"
                          VerticalAlignment="Top"
                          Grid.Row="1"
                          extensions:VisualExtensions.NormalizedCenterPoint="0.5,0.5,0"
                          animations:Implicit.ShowAnimations="{StaticResource CommonShowAnimations}"
                          animations:Implicit.HideAnimations="{StaticResource CommonHideAnimations}">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{ThemeResource SystemControlHighlightAltListAccentHighBrush}"
                                    BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}"
                                    BorderThickness="5,0,5,5"
                                    Margin="10,10,0,0">
                                <StackPanel>
                                    <Border Background="{ThemeResource SystemControlHighlightAccentBrush}">
                                        <TextBlock Text="{Binding Category}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="2" />
                                    </Border>

                                    <Image Source="{Binding ImageUrl}"
                                           Width="100"
                                           Height="100" />

                                    <StackPanel Width="100">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                                                   FontWeight="SemiBold"
                                                   Margin="7,5,5,5" />
                                        <TextBlock Text="{Binding Price}"
                                                   Foreground="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                                                   Margin="7,5,5,5" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <Grid Background="{ThemeResource SystemControlBackgroundBaseMediumBrush}"
                      Grid.Row="2">
                    <StackPanel Margin="20,10">
                        <TextBlock Text="What are 'Kudos'?"
                                   Foreground="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                                   Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock Text="This app is free for you, but we need to pay for services. You can help us keep the lights on by choosing a 'Kudo' from the list above."
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                                   Margin="0,0,0,0" />
                    </StackPanel>
                </Grid>

                <primitives:RadBusyIndicator x:Name="KudosBusyIndicator"
                                             Content="loading..."
                                             AnimationStyle="AnimationStyle5"
                                             Background="#CC000000"
                                             Grid.Row="1" />
            </Grid>
        </controls:DropShadowPanel>
    </Grid>
</UserControl>
