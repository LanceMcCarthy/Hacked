<UserControl x:Name="thisControl" 
             x:Class="Hacked.Controls.Help"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Hacked.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             Background="{ThemeResource SystemControlChromeHighAcrylicElementMediumBrush}"
             mc:Ignorable="d"
             d:DesignHeight="640"
             d:DesignWidth="360">

    <Grid  Background="{Binding Background, ElementName=thisControl}" >
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid MinWidth="340"
              MaxWidth="540"
              Margin="10"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              HorizontalAlignment="Center">
            <ListView x:Name="ArticlesListView"
                      ItemsSource="{x:Bind Articles}"
                      SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid 
                              Margin="0,0,5,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ToggleButton x:Name="AddAccountButton"
                                          Content="{Binding Title}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />

                            <TextBlock Text="{Binding Summary}"
                                       TextWrapping="WrapWholeWords"
                                       Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Grid.Row="1"
                                       Margin="0,10,0,10" />

                            <Image Source="{Binding ImageUrl}"
                                   MaxWidth="320"
                                   Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Grid.Row="2" />

                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>

        

        <Grid x:Name="ButtonGrid"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              Grid.Row="1">
            <Button x:Name="CloseButton"
                    Content="close help"
                    HorizontalAlignment="Center"
                    MinWidth="200"
                    Margin="10"
                    Click="CloseButton_OnClick" />
        </Grid>
        

    </Grid>
</UserControl>
