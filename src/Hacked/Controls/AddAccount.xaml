<UserControl x:Name="thisControl" 
             x:Class="Hacked.Controls.AddAccount"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Hacked.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:primitives="using:Telerik.UI.Xaml.Controls.Primitives"
             xmlns:controls="using:Microsoft.Toolkit.Uwp.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="400"
             Background="{ThemeResource SystemControlChromeHighAcrylicElementMediumBrush}"
             d:DesignWidth="360">

    <Grid Background="{Binding Background, ElementName=thisControl}">
        <controls:DropShadowPanel BlurRadius="20.0"
                                  ShadowOpacity="0.70"
                                  Color="Black" 
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center">
            <Border Background="{ThemeResource AppBarBackgroundThemeBrush}">
                <Grid Margin="20"
                  MinWidth="300">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="EmailInput"
                         Header="Add account to monitor"
                         Foreground="White"
                         InputScope="EmailNameOrAddress"
                         PlaceholderText="enter email address or username"
                         TextChanged="TxtChanged"
                         Grid.ColumnSpan="2" 
                         TabIndex="1"/>

                    <Button x:Name="AddButton"
                        Content="Add"
                        Click="OkayButton_OnClick"
                        Grid.Row="1"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Margin="0,20,5,0"
                        IsEnabled="False" />

                    <Button x:Name="CancelButton"
                        Content="Cancel"
                        Click="CancelButton_OnClick"
                        Grid.Row="1"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Margin="5,20,0,0" />

                    <primitives:RadBusyIndicator IsActive="{Binding IsBusy}"
                                             Content="{Binding IsBusyMessage}"
                                             AnimationStyle="AnimationStyle7"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             Background="#BFFFFFFF"
                                             Margin="0,20,0,0"
                                             Grid.RowSpan="2"
                                             Grid.ColumnSpan="2" />
                </Grid>
            </Border>
        </controls:DropShadowPanel>
        
    </Grid>
</UserControl>
