<ContentDialog x:Name="Self"
               x:Class="Hacked.Dialogs.KudosDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:local="using:Hacked.Dialogs"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:primitives="using:Telerik.UI.Xaml.Controls.Primitives"
               xmlns:controls="using:Telerik.UI.Xaml.Controls"
               xmlns:extensions="using:Microsoft.Toolkit.Uwp.UI.Extensions"
               xmlns:animations="using:Microsoft.Toolkit.Uwp.UI.Animations"
               xmlns:viewModels="using:Hacked.ViewModels"
               xmlns:vungleUi="using:VungleSDK.UI"
               mc:Ignorable="d"
               PrimaryButtonText="Done"
               PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
               Loaded="{x:Bind ViewModel.OnLoaded}"
               Unloaded="{x:Bind ViewModel.OnUnloaded}">

    <ContentDialog.DataContext>
        <viewModels:KudosViewModel x:Name="ViewModel" />
    </ContentDialog.DataContext>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderGrid"
              Height="48"
              Background="{ThemeResource SystemControlHighlightAltListAccentLowBrush}">
            <TextBlock Text="Available Kudos"
                       Style="{StaticResource TitleTextBlockStyle}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            <Button Content="Kudos Guide"
                    Foreground="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                    HorizontalAlignment="Right"
                    Margin="0,0,6,0">
                <Button.Flyout>
                    <Flyout>
                        <StackPanel MaxWidth="400">
                            <TextBlock Text="Kudos Guide"
                                       Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="Video Ad"
                                     FontWeight="SemiBold" />
                                <LineBreak />
                                <Run Text="You can play a quick video ad to generate revenue for the app (if you see a loading indicator, the next ad is being prepared)." />
                                <LineBreak />
                                <LineBreak />
                                <Run Text="Rating"
                                     FontWeight="SemiBold" />
                                <LineBreak />
                                <Run Text="You can leave an app review to let other potential users how much you like the app." />
                                <LineBreak />
                                <LineBreak />
                                <Run Text="Donations"
                                     FontWeight="SemiBold" />
                                <LineBreak />
                                <Run Text="To make monetary donations easy, the coffee, lunch and dinner items are in-app-purchases. Since they're 'consumable', you can purchase these items as often as you want to (e.g. a reward after a major update, etc)." />
                            </TextBlock>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <ListView ItemsSource="{Binding KudosCollection}"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="{x:Bind ViewModel.KudosGridView_OnItemClick}"
                  VerticalAlignment="Top"
                  Grid.Row="1"
                  extensions:VisualExtensions.NormalizedCenterPoint="0.5,0.5,0"
                  animations:Implicit.ShowAnimations="{StaticResource CommonShowAnimations}"
                  animations:Implicit.HideAnimations="{StaticResource CommonHideAnimations}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment"
                            Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Background="{ThemeResource SystemControlHighlightAltListAccentHighBrush}" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Background="{ThemeResource SystemControlHighlightAccentBrush}"
                              Width="100"
                              Height="100">
                            <Image Source="{Binding ImageUrl}" />
                        </Grid>

                        <TextBlock Text="{Binding Title}"
                                   Style="{ThemeResource TitleTextBlockStyle}"
                                   Foreground="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                                   Margin="10,5"
                                   Grid.Column="1" />
                        <TextBlock Text="{Binding Price}"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                   Foreground="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                                   Margin="10,5"
                                   Grid.Column="1"
                                   VerticalAlignment="Bottom"/>

                        <primitives:RadBusyIndicator IsActive="{Binding IsBusy}"
                                                     Content="loading ad..."
                                                     AnimationStyle="AnimationStyle5"
                                                     Background="#CC000000" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Background="{ThemeResource SystemControlBackgroundBaseMediumBrush}"
              Grid.Row="2">
            <StackPanel Margin="20,10">
                <TextBlock Text="What are 'Kudos'?"
                           Foreground="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                           Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="This app is free, but the services it requires are to operate not free. You can help the developer keep the app up and running by choosing a Kudos from the list above."
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                           Margin="0,0,0,0" />
            </StackPanel>
        </Grid>

        <vungleUi:VungleAdControl x:Name="VungleAd2"
                                  AppID="5e347706c28ba7001748f549"
                                  Placement="KUDOSAD-0259168"
                                  Placements="KUDOSAD-0259168"
                                  ApiEndpoint="https://ads.api.vungle.com"
                                  IsHitTestVisible="False"
                                  Grid.Row="1"
                                  OnAdStart="{x:Bind ViewModel.VungleAd2_Start}"
                                  OnAdEnd="{x:Bind ViewModel.VungleAd2_End}" />

        <!--<primitives:RadBusyIndicator Content="{x:Bind ViewModel.IsBusyMessage, Mode=OneWay}"
                                     IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                     Style="{StaticResource PageBusyIndicatorStyle}"
                                     Grid.Row="1"
                                     Grid.RowSpan="2" />-->
    </Grid>
</ContentDialog>
