<Window x:Class="Hacked.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hacked.Wpf"
        xmlns:viewModels="clr-namespace:Hacked.Wpf.ViewModels"
        xmlns:controls="clr-namespace:Hacked.Wpf.Controls"
        xmlns:views="clr-namespace:Hacked.Wpf.Views"
        mc:Ignorable="d"
        Icon="Images\Icon.ico"
        Title="Hacked?"
        UseLayoutRounding="True"
        WindowState="Normal"
        WindowStartupLocation="CenterScreen"
        Height="900"
        Width="1200">

    <Window.DataContext>
        <viewModels:MainWindowViewModel />
    </Window.DataContext>

    <Grid>
        <telerik:RadDocking>
            <telerik:RadDocking.DocumentHost>
                <telerik:RadSplitContainer>
                    <telerik:RadPaneGroup>
                        <telerik:RadPane Header="Description">
                            <views:MonitoredAccountDetailsView />
                        </telerik:RadPane>
                        <telerik:RadPane Header="Kudos"
                                         CanFloat="False">
                            <views:KudosView />
                        </telerik:RadPane>
                    </telerik:RadPaneGroup>
                </telerik:RadSplitContainer>
            </telerik:RadDocking.DocumentHost>

            <telerik:RadSplitContainer InitialPosition="DockedLeft">
                <telerik:RadPaneGroup>
                    <telerik:RadPane Header="Monitored Accounts">
                        <views:MonitoredAccountsView />
                    </telerik:RadPane>
                    <telerik:RadPane Header="Tools">
                        <Grid>
                            <StackPanel VerticalAlignment="Bottom">
                                <Button Content="Export Accounts"
                                        Command="{Binding ExportAccountsCommand}"
                                        Margin="5"/>
                                <Button Content="Import Accounts"
                                        Command="{Binding ImportAccountsCommand}"
                                        Margin="5,0,5,5"/>
                            </StackPanel>
                        </Grid>
                    </telerik:RadPane>
                </telerik:RadPaneGroup>
            </telerik:RadSplitContainer>

            <telerik:RadSplitContainer InitialPosition="DockedRight">
                <telerik:RadPaneGroup>
                    <telerik:RadPane Header="Add">
                        <Grid>
                            <views:AddAccountView />
                        </Grid>
                    </telerik:RadPane>
                    <telerik:RadPane Header="About">
                        <controls:LancelotSoftware VerticalAlignment="Top" />
                    </telerik:RadPane>
                </telerik:RadPaneGroup>
            </telerik:RadSplitContainer>

            <telerik:RadSplitContainer InitialPosition="DockedBottom">
                <telerik:RadPaneGroup>
                    <telerik:RadPane Header="Output" />
                    <telerik:RadPane Header="Error List" />
                </telerik:RadPaneGroup>
            </telerik:RadSplitContainer>
        </telerik:RadDocking>

        <telerik:RadBusyIndicator IsBusy="{Binding IsBusy}"
                                  BusyContent="{Binding IsBusyMessage}"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                                  Background="#BFFFFFFF"
                                  Foreground="RoyalBlue" />
    </Grid>
</Window>
