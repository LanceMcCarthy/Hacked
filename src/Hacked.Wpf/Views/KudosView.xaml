            </Button>

            <Button Content="X"
                    Command="{Binding ShowKudosCommand}"
                    HorizontalAlignment="Right"
                    Margin="10" />
        </Grid>

        <telerik:RadTileList x:Name="KudosGridView"
                             SelectionMode="Single"
                             SelectionChanged="KudosGridView_OnSelectionChanged"
                             VerticalAlignment="Top"
                             Grid.Row="1">
            <telerik:RadTileList.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="5,0,5,5"
                            Margin="10,10,0,0">
                        <StackPanel>
                            <Border>
                                <TextBlock Text="{Binding Category}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="2" />
                            </Border>

                            <Image Source="{Binding ImageUrl}"
                                   Width="100"
                                   Height="100" />

                            <StackPanel Width="100">
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="SemiBold"
                                           Margin="7,5,5,5" />
                                <TextBlock Text="{Binding Price}"
                                           Margin="7,5,5,5" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </telerik:RadTileList.ItemTemplate>
        </telerik:RadTileList>

        <Grid Grid.Row="2">
            <StackPanel Margin="20,10">
                <TextBlock Text="What are 'Kudos'?" />
                <TextBlock Text="This app is free for you, but we need to pay for services. You can help us keep the lights on by choosing a 'Kudo' from the list above."
                           TextWrapping="Wrap"
                           Margin="0,0,0,0" />
            </StackPanel>
        </Grid>

        <telerik:RadBusyIndicator x:Name="KudosBusyIndicator"
                                  Content="loading..."
                                  Background="#CC000000"
                                  Grid.Row="1" />
    </Grid>
</UserControl>
