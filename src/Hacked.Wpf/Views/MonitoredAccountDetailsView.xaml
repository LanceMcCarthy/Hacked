<UserControl x:Class="Hacked.Wpf.Views.MonitoredAccountDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Hacked.Wpf.Views"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <DataTemplate x:Key="BreachesSquareItemTemplate">
            <Grid Margin="10,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="10,5,10,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding Name}"
                               FontSize="22"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />

                    <Button Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="Red"
                            Foreground="White"
                            VerticalAlignment="Center"
                            Margin="10,0"
                            Grid.Column="1">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="New!"
                                           Margin="5" />
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button Margin="0,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Padding="2"
                            Grid.Column="2"
                            Click="BreachInfoButton_Click">
                        <telerik:RadGlyph Glyph="&#xE946;"/>
                    </Button>
                </Grid>

                <Image Source="{Binding LogoPath}"
                       Width="200"
                       Height="200"
                       Grid.Row="1"
                       Grid.RowSpan="2"
                       Opacity="0.4" />

                <StackPanel Orientation="Horizontal"
                            Grid.Row="1">
                    <TextBlock Text="{Binding PwnCount}"
                               FontWeight="SemiBold"
                               Margin="6" />
                    <TextBlock Text="accounts stolen on"
                               Margin="6" />
                    <TextBlock Text="{Binding BreachDate, Converter={StaticResource DisplayDateConverter}}"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="6" />
                </StackPanel>

                <HeaderedItemsControl ItemsSource="{Binding DataClasses}"
                                                 Grid.Row="2"
                                                 Padding="10,0"
                                                 Margin="0,5,0,0">
                    <HeaderedItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="3"
                                    ToolTipService.ToolTip="{Binding}"
                                    Padding="5,3">
                                <TextBlock Text="{Binding}"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           FontSize="10" />
                            </Border>
                        </DataTemplate>
                    </HeaderedItemsControl.ItemTemplate>
                    <HeaderedItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin"
                                    Value="0,0,10,10" />
                        </Style>
                    </HeaderedItemsControl.ItemContainerStyle>
                    <HeaderedItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </HeaderedItemsControl.ItemsPanel>
                </HeaderedItemsControl>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Bottom"
                                Margin="5,0">
                        <TextBlock Text="a:"
                                   Style="{StaticResource SubtleSmallStyle}" 
                                   Margin="6"/>
                        <TextBlock Text="{Binding AddedDate, Converter={StaticResource DisplayDateConverter}}"
                                   Style="{StaticResource SubtleSmallStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="6" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Bottom"
                                Margin="10,0"
                                Grid.Column="1">
                        <TextBlock Text="m:"
                                   Style="{StaticResource SubtleSmallStyle}"
                                   Margin="6" />
                        <TextBlock Text="{Binding ModifiedDate, Converter={StaticResource DisplayDateConverter}}"
                                   Style="{StaticResource SubtleSmallStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="6" />
                    </StackPanel>

                    <telerik:RadHyperlinkButton Content="{Binding Domain}"
                                                FontSize="10"
                                                Margin="5,-5,5,-5"
                                                NavigateUri="{Binding Domain, Converter={StaticResource StringToUriConverter}}"
                                                Grid.Column="2"
                                                Foreground="WhiteSmoke" />
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderGrid"
              Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock FontSize="32"
                       FontWeight="Bold"
                       Text="{Binding SelectedAccount.Address}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Grid.Row="1" />

            <StackPanel Grid.Row="2"
                        Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <TextBlock Text="Breaches -" />
                    <TextBlock Text="Total:"
                               Margin="5,0,0,0" />
                    <TextBlock Margin="5,0,0,0"
                               Text="{Binding SelectedAccount.Breaches.Count}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="| New:"
                               Margin="5,0,0,0" />
                    <TextBlock Margin="5,0,0,0"
                               Foreground="{Binding SelectedAccount.HasNewBreaches, Converter={StaticResource BoolToBrushConverter}}"
                               Text="{Binding SelectedAccount.NewBreachCount}"
                               FontWeight="SemiBold" />
                    <telerik:RadHyperlinkButton x:Name="ClearNewHyperlinkButton"
                                                Margin="10,-6,0,-6"
                                                Content="Mark all seen"
                                                Visibility="{Binding SelectedAccount.HasNewBreaches, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Click="ClearNewHyperlinkButton_OnClick" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <TextBlock Text="Last Updated -" />
                    <TextBlock Margin="5,0,0,0"
                               Text="{Binding SelectedAccount.LastUpdated}" />
                </StackPanel>
                <Button x:Name="SelectedAccountRefresh"
                        HorizontalAlignment="Center"
                        Command="{Binding FindSelectedAccountBreachCommand}"
                        IsEnabled="{Binding SelectedAccount.IsUpdating, Converter={StaticResource InvertBoolConverter}}"
                        Visibility="{Binding SelectedAccount, Converter={StaticResource NullToVisibilityConverter}}"
                        Margin="0,5,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Refresh Now"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ListView x:Name="BreachesListView"
                  Background="Transparent"
                  ItemsSource="{Binding SelectedAccount.Breaches}"
                  ItemTemplate="{StaticResource BreachesSquareItemTemplate}"
                  Grid.Row="1">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding"
                            Value="0" />
                    <Setter Property="Margin"
                            Value="0,0,10,0" />
                    <Setter Property="HorizontalContentAlignment"
                            Value="Stretch" />
                    <Setter Property="VerticalContentAlignment"
                            Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</UserControl>
