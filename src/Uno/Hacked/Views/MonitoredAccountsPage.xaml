<Page x:Class="Hacked.Views.MonitoredAccountsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:models="using:Hacked.Core.Models"
      mc:Ignorable="d"
      Background="{ThemeResource BackgroundBrush}">
  <Page.Resources>
    <utu:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  </Page.Resources>

  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <utu:NavigationBar Content="Hacked?" Grid.Row="0">
      <utu:NavigationBar.PrimaryCommands>
        <AppBarButton Label="Check All"
                      Command="{Binding CheckAllAccountsCommand}">
          <AppBarButton.Icon>
            <SymbolIcon Symbol="Refresh" />
          </AppBarButton.Icon>
        </AppBarButton>
      </utu:NavigationBar.PrimaryCommands>
    </utu:NavigationBar>

    <TextBlock Grid.Row="1"
               Text="No accounts monitored. Tap + to add one."
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               TextAlignment="Center"
               Margin="24"
               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

    <ListView Grid.Row="1"
              ItemsSource="{Binding Accounts}"
              SelectionMode="None">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="models:MonitoredAccount">
          <Grid Margin="12,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="{Binding Address}" FontWeight="Bold" />
              <TextBlock>
                <Run Text="{Binding Breaches.Count}" />
                <Run Text=" breach(es)" />
              </TextBlock>
              <TextBlock Text="{Binding LastUpdated}" FontSize="11" Opacity="0.6" />
            </StackPanel>
            <Border Grid.Column="1"
                    Background="OrangeRed"
                    CornerRadius="4"
                    Padding="6,2"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasNewBreaches, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="NEW" Foreground="White" FontSize="11" FontWeight="Bold" />
            </Border>
            <ProgressRing Grid.Column="2"
                          IsActive="{Binding IsUpdating}"
                          Width="20" Height="20"
                          VerticalAlignment="Center"
                          Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibility}}" />
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <Button Grid.Row="2"
            Content="+ Add Account"
            Command="{Binding NavigateToAddAccountCommand}"
            HorizontalAlignment="Right"
            Margin="16" />

    <Grid Grid.Row="0" Grid.RowSpan="3"
          Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
          Background="{ThemeResource BackgroundBrush}"
          Opacity="0.7">
      <ProgressRing IsActive="{Binding IsBusy}"
                    Width="60" Height="60"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
    </Grid>
  </Grid>
</Page>
