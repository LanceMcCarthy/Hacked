<Page x:Class="Hacked.Views.PasswordCheckPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:utu="using:Uno.Toolkit.UI"
      mc:Ignorable="d"
      Background="{ThemeResource BackgroundBrush}">
  <Page.Resources>
    <utu:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  </Page.Resources>

  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <utu:NavigationBar Content="Password Check" Grid.Row="0" />

    <StackPanel Grid.Row="1" Padding="20" Spacing="16">
      <TextBlock Text="Check if your password has been exposed in a data breach. Your password is never sent — only a partial hash is used."
                 TextWrapping="Wrap"
                 Opacity="0.7" />

      <PasswordBox Header="Password"
                   Password="{Binding Password, Mode=TwoWay}"
                   PlaceholderText="Enter password to check" />

      <Button Content="Check Password"
              Command="{Binding CheckPasswordCommand}"
              HorizontalAlignment="Stretch" />

      <ProgressRing IsActive="{Binding IsBusy}"
                    Width="40" Height="40"
                    HorizontalAlignment="Center"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

      <TextBlock Text="{Binding Result}"
                 TextWrapping="Wrap"
                 FontSize="16" />

      <TextBlock Text="Powered by HaveIBeenPwned.com"
                 FontSize="11"
                 Opacity="0.5"
                 HorizontalAlignment="Center" />
    </StackPanel>
  </Grid>
</Page>
